# Registry of warm modules under /opt/ops/<id>
# Format: ID|GIT_URL|GIT_REF|COMPOSE_FILE
# Lines starting with # are ignored.
#
# hub is special: often the same clone that provides this ops/ tree.

hub|https://github.com/OCherep/devops-hub.git|main|docker-compose.yml
radar|https://github.com/OCherep/kstv-tech_radar.git|grok-0.0.1|docker-compose.yml
oncall|https://github.com/OCherep/oncall-system.git|grok-1.0.0|docker-compose.yml
edge|.|main|docker-compose.yml

# Future examples (uncomment when ready):
# service-catalog|https://github.com/OCherep/service-catalog.git|main|docker-compose.yml
# runbooks|https://github.com/OCherep/runbooks-portal.git|main|docker-compose.yml
# dora-dashboard|https://github.com/OCherep/dora-dashboard.git|main|docker-compose.yml
